{
  "name": "surgical-outcomes-database",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.development -- next dev --turbo",
    "build": "next build",
    "start": "dotenv -e .env.production -- next start",
    "lint": "next lint",
    "test:perf": "node scripts/performance-test.mjs",
    "test:load1000": "node scripts/load-test-1000.mjs",
    "test:frameworks": "node scripts/verify-all-frameworks.mjs",
    "dev:staging": "dotenv -e .env.staging -- next dev --turbo",
    "build:staging": "dotenv -e .env.staging -- next build",
    "build:dev": "dotenv -e .env.development -- next build",
    "typecheck": "tsc --noEmit",
    "db:push:dev": "node scripts/db-push.mjs development",
    "db:push:staging": "node scripts/db-push.mjs staging",
    "db:push:prod": "node scripts/db-push.mjs production --yes",
    "db:types": "node scripts/db-types.mjs",
    "db:migrate": "dotenv -e infra/.env -- node scripts/migrate.mjs",
    "db:migrate:dry": "dotenv -e infra/.env -- node scripts/migrate.mjs --dry",
    "build:prod": "dotenv -e .env.production -- next build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.1",
    "next": "^15.1.4",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
