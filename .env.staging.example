# RALP Database v2 — staging
# Copy to .env.staging and fill in. Never commit the filled-in file.

NEXT_PUBLIC_APP_NAME="Surgical Outcomes Database (RALP v2)"
NEXT_PUBLIC_APP_VERSION="2.0.0"
NEXT_PUBLIC_APP_ENV="staging"

# PostgreSQL connection. Server-only secret — never prefix with NEXT_PUBLIC_.
DATABASE_URL="postgres://ralp:CHANGE_ME@staging-db-host:5432/ralp"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=""

# Object storage (documents). Local filesystem by default; swap to S3/MinIO later.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
