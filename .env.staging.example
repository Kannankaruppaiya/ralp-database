# RALP Database v2 — staging
# Copy to .env.staging and fill in from the Supabase dashboard
# (Project Settings -> API). Never commit the filled-in file.

NEXT_PUBLIC_APP_NAME="Surgical Outcomes Database (RALP v2)"
NEXT_PUBLIC_APP_VERSION="2.0.0"
NEXT_PUBLIC_APP_ENV="staging"

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Server-only. Bypasses row level security — never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Used by scripts/db-push.mjs to apply migrations to this tier
SUPABASE_PROJECT_REF="<project-ref>"
SUPABASE_DB_PASSWORD=""
