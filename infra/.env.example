# RALP Database v2 — self-hosted infrastructure config.
# Copy to `.env` inside infra/ and fill in. Never commit the filled-in file.

# --- PostgreSQL (docker-compose.yml reads these) ---
POSTGRES_USER=ralp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ralp
POSTGRES_PORT=5432

# --- Application / migration runner ---
# Full connection string the app and scripts/migrate.mjs use.
DATABASE_URL=postgres://ralp:change_me@localhost:5432/ralp

# Secret used to sign our own session JWTs (Phase 1 — own auth). Generate a long
# random value in production, e.g. `openssl rand -base64 48`.
JWT_SECRET=change_me_to_a_long_random_secret

# --- Object storage (Phase 4) ---
# Default is the local filesystem; swap to S3/MinIO later without code changes.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
