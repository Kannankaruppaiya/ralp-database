# RALP Database v2 — production
# Copy to .env.production and fill in. Never commit the filled-in file.

NEXT_PUBLIC_APP_NAME="Surgical Outcomes Database (RALP v2)"
NEXT_PUBLIC_APP_VERSION="2.0.0"
NEXT_PUBLIC_APP_ENV="production"

# PostgreSQL connection. Server-only secret — never prefix with NEXT_PUBLIC_.
# Points at the database on the client's own server / VM (e.g. AWS RDS or a
# self-managed Postgres on the same host as the app).
DATABASE_URL="postgres://ralp:CHANGE_ME@prod-db-host:5432/ralp"

# Secret used to sign session JWTs. MUST be a long random value in production.
# Generate with: openssl rand -base64 48
JWT_SECRET=""

# Object storage (documents). Local volume, or an S3/MinIO endpoint.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="/var/lib/ralp/storage"
